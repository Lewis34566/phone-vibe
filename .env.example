# ===== 手机版 Agent 配置 =====
# DeepSeek API Key（https://platform.deepseek.com/api_keys 申请，国内直连可用）
# 也可以先留空：bash start.sh 后，在网页顶部横幅里粘贴，自动保存到这个文件。
# 填 "mock" 可进入演示模式（不花钱，模拟 Lewis 写一个记账小工具）
DEEPSEEK_API_KEY=

# 使用的模型：deepseek-v4-pro（能力强）或 deepseek-flash（更快更便宜）
MODEL=deepseek-v4-pro

# 主服务端口
PORT=8787

# 项目保存目录（默认 ~/storage/shared/PhoneProjects，即 /sdcard/PhoneProjects，一般不用改）
# PHONE_PROJECTS_DIR=

# Lewis 做完后自动用 termux-open-url 拉起浏览器打开预览（0 关闭）
AUTO_OPEN=1

# v1.5：是否允许 Lewis 读写项目目录以外的手机存储（默认 1 = 整个手机）
# 填 0 会回到"只能在项目文件夹里干活"的沙盒模式
ALLOW_ANY_PATH=1

# 发消息通道（可选，配了才能用对应的发送方式）：
# 企业微信群机器人 webhook：企业微信群 → 添加机器人 → 复制 webhook 地址
# WECOM_WEBHOOK_URL=
# QQ 机器人（OneBot 协议，如电脑上跑 NapCat 挂 QQ 小号）的 HTTP API 地址
# ONEBOT_API_URL=
