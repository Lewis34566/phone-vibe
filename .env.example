# ===== 手机版 Agent 配置 =====

# ---- 主模型（任何 OpenAI 兼容服务商都可以，默认 DeepSeek）----
# 通用 Key 字段（推荐）：界面横幅粘贴的 Key 也存这里
LLM_API_KEY=
# 兼容旧字段名：DEEPSEEK_API_KEY / OPENAI_API_KEY / API_KEY / ANTHROPIC_API_KEY 仍可读

# 接口地址（填哪家就用哪家）：
#   DeepSeek（默认，国内直连）: https://api.deepseek.com/chat/completions
#   OpenAI:                    https://api.openai.com/v1/chat/completions
#   通义千问（阿里）:           https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
#   智谱 GLM:                  https://open.bigmodel.cn/api/paas/v4/chat/completions
#   Kimi（月之暗面）:          https://api.moonshot.cn/v1/chat/completions
#   本地 ollama 当主模型:       http://127.0.0.1:11434/v1/chat/completions
LLM_API_URL=https://api.deepseek.com/chat/completions

# 模型名（换成对应服务商的，如 gpt-4o / qwen-plus / glm-4 / kimi-k2 / qwen2.5:3b）
MODEL=deepseek-v4-pro

# 图片理解模型（拍照看图用，换成对应服务商的视觉模型名）
VISION_MODEL=deepseek-flash

# 填 "mock" 可进入演示模式（不花钱，模拟 Lewis 写一个记账小工具）
# 没有 Key 也可以先在网页顶部横幅里粘贴，自动保存到这个文件。

# ---- 主服务端口 ----
PORT=8787

# ---- 项目保存目录（默认 ~/storage/shared/PhoneProjects，一般不用改）----
# PHONE_PROJECTS_DIR=

# ---- Lewis 做完后自动用 termux-open-url 拉起浏览器打开预览（0 关闭）----
AUTO_OPEN=1

# ---- 是否允许 Lewis 读写项目目录以外的手机存储（默认 1 = 整个手机）----
# 填 0 会回到"只能在项目文件夹里干活"的沙盒模式
ALLOW_ANY_PATH=1

# ---- 发消息通道（可选，配了才能用对应的发送方式）----
# 企业微信群机器人 webhook：企业微信群 → 添加机器人 → 复制 webhook 地址
# WECOM_WEBHOOK_URL=
# QQ 机器人（OneBot 协议，如电脑上跑 NapCat 挂 QQ 小号）的 HTTP API 地址
# ONEBOT_API_URL=

# ---- 离线兜底：主模型连不上时自动切手机本地模型 ----
# 安装：pkg install ollama && ollama serve & && ollama pull qwen2.5:3b
# LOCAL_LLM_URL=http://127.0.0.1:11434/v1
# LOCAL_LLM_MODEL=qwen2.5:3b
