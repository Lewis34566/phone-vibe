# ===== 手机本机 Vibe Coding 配置 =====
# Anthropic API Key（https://console.anthropic.com 申请）
# 也可以先留空：bash start.sh 后，在网页顶部横幅里粘贴，自动保存到这个文件。
# 填 "mock" 可进入演示模式（不花钱，模拟 Agent 写一个记账小工具）
ANTHROPIC_API_KEY=

# 使用的模型（默认最新 Sonnet，可按需改成其他模型 ID）
MODEL=claude-sonnet-5-5

# 主服务端口
PORT=8787

# 项目保存目录（默认 ~/storage/shared/PhoneProjects，即 /sdcard/PhoneProjects，一般不用改）
# PHONE_PROJECTS_DIR=

# Agent 做完后自动用 termux-open-url 拉起浏览器打开预览（0 关闭）
AUTO_OPEN=1
